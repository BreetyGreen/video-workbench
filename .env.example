# 公开模板：所有外部服务凭据默认留空；本地剪辑无需填写任何 Key。
# Windows/Docker 会读取本文件复制出的根目录 .env。
# macOS 原生启动不会读取仓库 .env；可选值由用户放入启动进程环境。

# Windows/Docker 本地服务与 ArcReel 安全值（start.ps1 会生成缺失的秘密）
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_TOKEN_SECRET=
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 留空时控制面会在本地数据目录自动生成；只用于加密本机用量凭据。
VIDEO_WORKBENCH_USAGE_SECRET_MASTER_KEY=

# 启动脚本通常会覆盖这些本地路径/工具；只有自定义运行目录时才修改。
VIDEO_WORKBENCH_DATA_DIR=data/control-plane
VIDEO_WORKBENCH_DATABASE_URL=sqlite:///data/control-plane/control-plane.db
VIDEO_WORKBENCH_FFMPEG_BIN=ffmpeg
VIDEO_WORKBENCH_FFPROBE_BIN=ffprobe

# Dify 可选增强：教程拆解与爆款分析；留空时使用本地策略。
VIDEO_WORKBENCH_DIFY_BASE_URL=
VIDEO_WORKBENCH_DIFY_TUTORIAL_API_KEY=
VIDEO_WORKBENCH_DIFY_VIRAL_API_KEY=
VIDEO_WORKBENCH_DIFY_TIMEOUT_SECONDS=90

# 本地转写与视频分析：无需账号，首次使用会下载模型。
VIDEO_WORKBENCH_TRANSCRIPTION_ENABLED=true
VIDEO_WORKBENCH_WHISPER_MODEL=small
VIDEO_WORKBENCH_WHISPER_PREVIEW_MODEL=small
VIDEO_WORKBENCH_WHISPER_QUALITY_MODEL=large-v3
VIDEO_WORKBENCH_WHISPER_DEVICE=cpu
VIDEO_WORKBENCH_WHISPER_COMPUTE_TYPE=int8
VIDEO_WORKBENCH_WHISPER_CPU_THREADS=0
VIDEO_WORKBENCH_OCR_ENABLED=true
VIDEO_WORKBENCH_SCENE_THRESHOLD=0.25
VIDEO_WORKBENCH_SILENCE_THRESHOLD_DB=-42
VIDEO_WORKBENCH_SILENCE_MINIMUM_SECONDS=0.8
VIDEO_WORKBENCH_KEYFRAME_LIMIT=12

# 火山 BigASR 可选增强：API Key，或 App Key + Access Key 二选一。
# 只有生产档逐任务允许云处理时才发送音频；否则使用本地 large-v3。
VIDEO_WORKBENCH_VOLCANO_ASR_API_KEY=
VIDEO_WORKBENCH_VOLCANO_ASR_APP_KEY=
VIDEO_WORKBENCH_VOLCANO_ASR_ACCESS_KEY=
VIDEO_WORKBENCH_VOLCANO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
VIDEO_WORKBENCH_VOLCANO_ASR_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VIDEO_WORKBENCH_VOLCANO_ASR_TIMEOUT_SECONDS=180

# 火山 TTS 可选增强：云端旁白；留空时保留原始音轨继续处理。
VIDEO_WORKBENCH_VOLCANO_TTS_API_KEY=
VIDEO_WORKBENCH_VOLCANO_TTS_RESOURCE_ID=seed-tts-2.0
VIDEO_WORKBENCH_VOLCANO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VIDEO_WORKBENCH_VOLCANO_TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts
VIDEO_WORKBENCH_VOLCANO_TTS_TIMEOUT_SECONDS=90

# 本地渲染与质量门禁：无需账号。
VIDEO_WORKBENCH_RENDER_PRESET=medium
VIDEO_WORKBENCH_RENDER_CRF=23
VIDEO_WORKBENCH_QUALITY_MAX_BLACK_SECONDS=0.5
VIDEO_WORKBENCH_QUALITY_MAX_SILENCE_SECONDS=1.5
VIDEO_WORKBENCH_QUALITY_DURATION_TOLERANCE_SECONDS=0.25
VIDEO_WORKBENCH_COVER_FONT_PATH=

# 抖音外部授权：搜索需要应用审批；发布还需要发布账号 OAuth。
VIDEO_WORKBENCH_DOUYIN_CLIENT_KEY=
VIDEO_WORKBENCH_DOUYIN_CLIENT_SECRET=
VIDEO_WORKBENCH_DOUYIN_DEVICE_ID=0
VIDEO_WORKBENCH_DOUYIN_OPEN_ID=
VIDEO_WORKBENCH_DOUYIN_ACCESS_TOKEN=

# 公共/生成素材可选增强；留空时使用用户上传和本地授权素材。
VIDEO_WORKBENCH_PEXELS_API_KEY=
VIDEO_WORKBENCH_PEXELS_API_BASE_URL=https://api.pexels.com
VIDEO_WORKBENCH_PEXELS_TIMEOUT_SECONDS=60
VIDEO_WORKBENCH_PEXELS_MAX_DOWNLOAD_BYTES=262144000
VIDEO_WORKBENCH_PIXABAY_API_KEY=
VIDEO_WORKBENCH_PIXABAY_API_BASE_URL=https://pixabay.com
VIDEO_WORKBENCH_PIXABAY_TIMEOUT_SECONDS=60
VIDEO_WORKBENCH_SEEDANCE_API_KEY=
VIDEO_WORKBENCH_SEEDANCE_MODEL=
VIDEO_WORKBENCH_SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 每日自动化：本地能力；外部提供方未配置时按各自降级路径运行。
VIDEO_WORKBENCH_AUTOMATION_ENABLED=true
VIDEO_WORKBENCH_AUTOMATION_SCHEDULER_ENABLED=true
VIDEO_WORKBENCH_AUTOMATION_HOUR=8
VIDEO_WORKBENCH_AUTOMATION_MINUTE=30
VIDEO_WORKBENCH_AUTOMATION_TIMEZONE=Asia/Shanghai
VIDEO_WORKBENCH_AUTOMATION_KEYWORDS=宠物,萌宠
VIDEO_WORKBENCH_AUTOMATION_POLL_SECONDS=60
VIDEO_WORKBENCH_AUTOMATION_AUTO_CREATE_TASKS=true
VIDEO_WORKBENCH_AUTOMATION_TASK_LIMIT=1
VIDEO_WORKBENCH_AUTOMATION_MATERIAL_COUNT=3
VIDEO_WORKBENCH_PUBLIC_TREND_WEB_ENABLED=true
VIDEO_WORKBENCH_PUBLIC_TREND_WEB_ENDPOINT=https://html.duckduckgo.com/html/
VIDEO_WORKBENCH_PUBLIC_TREND_WEB_TIMEOUT_SECONDS=20

# 钉钉外部授权：Windows/Docker Stream 连接器；留空时使用工作台上传。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_MAX_FILE_BYTES=524288000
DINGTALK_DEDUP_DATABASE=data/dingtalk/dedup.db
# 原生控制面诊断使用同一凭据的 VIDEO_WORKBENCH_ 前缀；Docker Compose 会自动映射。
VIDEO_WORKBENCH_DINGTALK_CLIENT_ID=
VIDEO_WORKBENCH_DINGTALK_CLIENT_SECRET=
