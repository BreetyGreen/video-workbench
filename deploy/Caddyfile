  admin 0.0.0.0:2019
}

{$VIDEO_WORKBENCH_DOMAIN:localhost} {
  encode zstd gzip
  @device_api path /api/devices/pair /api/devices/me/*
  handle @device_api {
    reverse_proxy control-plane:8130
  }
  handle {
    basic_auth {
      {$AUTH_USERNAME} {$VIDEO_WORKBENCH_BASIC_AUTH_HASH}
    }
    reverse_proxy control-plane:8130
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
  }
}
