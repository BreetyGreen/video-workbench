# Production template. Copy this file to the repository root as
# .env.production, replace every replace-with-* value, then restrict it to the
# deployment administrator. Never commit the populated file.

VIDEO_WORKBENCH_DOMAIN=video.example.com
AUTH_USERNAME=replace-with-admin-user
VIDEO_WORKBENCH_BASIC_AUTH_HASH=replace-with-caddy-hash
AUTH_TOKEN_SECRET=replace-with-random-secret
VIDEO_WORKBENCH_USAGE_SECRET_MASTER_KEY=replace-with-random-secret

TZ=Asia/Shanghai
LOG_LEVEL=INFO
VIDEO_WORKBENCH_AUTOMATION_ENABLED=true
VIDEO_WORKBENCH_AUTOMATION_SCHEDULER_ENABLED=true
VIDEO_WORKBENCH_PUBLIC_TREND_WEB_ENABLED=true

# Optional cloud enhancements. Leave blank to keep the zero-Key local path.
VIDEO_WORKBENCH_DIFY_BASE_URL=
VIDEO_WORKBENCH_DIFY_TUTORIAL_API_KEY=
VIDEO_WORKBENCH_DIFY_VIRAL_API_KEY=
VIDEO_WORKBENCH_VOLCANO_ASR_API_KEY=
VIDEO_WORKBENCH_VOLCANO_TTS_API_KEY=
VIDEO_WORKBENCH_PEXELS_API_KEY=
VIDEO_WORKBENCH_PIXABAY_API_KEY=
VIDEO_WORKBENCH_SEEDANCE_API_KEY=
VIDEO_WORKBENCH_SEEDANCE_MODEL=

# External platform authorization. Keep blank until the corresponding
# organization/application approval has completed.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
VIDEO_WORKBENCH_DOUYIN_CLIENT_KEY=
VIDEO_WORKBENCH_DOUYIN_CLIENT_SECRET=
VIDEO_WORKBENCH_DOUYIN_DEVICE_ID=0
VIDEO_WORKBENCH_DOUYIN_OPEN_ID=
VIDEO_WORKBENCH_DOUYIN_ACCESS_TOKEN=
